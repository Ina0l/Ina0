// there's no built-in randint so you need to make one yourself

def: randint <- a, b
    // make sure a < b
    if: a > b
        nb: i = a
        nb: a = b
        nb: b = i
    end_if

    nb: gap = b - a
    nb: exponent = 0
    while: gap > 2^exponent
        nb: exponent = exponent + 1
    end_while

    nb: result = 2^(exponent + 1) + a
    while: result > b
        nb: result = a
        nb: counter = 0
        while: counter < exponent + 1
            random: bit
            if: bit
                nb: result = result + (2^counter)
            end_if
            nb: counter = counter + 1
        end_while
    end_while
    return: result
end_def

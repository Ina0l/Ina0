// Function Testing Script

def: function <- a, b // Defining a function that takes two parameters a and b
    nb: a = a + 1
    nb: b = b + 1
    return: a * b
enddef

nb: a = 4

function: c <- 6, 5 // calling the function with a=6 and b=5, and storing the output value in c
out: c
function: c <- c, 1
out: c

out: a // check if parameter value is still the same outside of the function
// Check if internally defined variables aren't defined outside of the function
// Should throw an error
// out: b

// this can be used as an empty print()
out

def: function2 <- a
    nb: b = a * 5
    nb: c = a + 6
    nb: d = b*c
    out: d
enddef
// As you can see this function returns nothing, so you call it like that:
function2: <- 6

out

// Define a recursive function to calculate the factorial of a number
def: factorial <- n
    if: n == 1
        nb: result = 1
    endif
    if: n != 1
        factorial: a <- n - 1
        nb: result = n * a
    endif
    return: result
enddef

nb: n = 6
// Call the recursive factorial function
factorial: a <- n
out: "factorial of " + n
out: a // should be 720 as 6!=720
// Test boolean operations
bool: result1 = true or false
out: result1 // Expect true

bool: result2 = true and false
out: result2 // Expect false

bool: result3 = not true
out: result3 // Expect false

bool: result4 = true xor false
out: result4 // Expect true

// Test nested boolean expressions
bool: result5 = (true and (false or true)) and not false
out: result5 // Expect true
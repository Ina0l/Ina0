// Test string concatenation
str: greeting = "Hello" + " "+ "World"
out: greeting // Expect "Hello World"

// Test string with variables
str: name = "User"
str: message = "Hello, " + name
out: message // Expect "Hello, User"

// 0-based character getter
get: char <- message, 7
out: char // Expect U

// string length
len: length <- message
out: length


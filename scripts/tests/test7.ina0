// List Testing Script

// Create a new list
make_list: test_list

make_list: test_list_2
append: <- test_list_2, test_list, "aaa"
out: test_list_2

// Add items to the list
append: <- test_list, "item1", "item2", "item3"

// Output the list to check the current state
out: test_list
out: test_list_2 // as you can see, lists within lists are only stored as addresses

// Remove the first instance of an item from the list
remove: <- test_list, "item2"

// Output the modified list
out: test_list

// Get the length of the list
len: test_length <- test_list
out: test_length

// Test if a particular item exists in the list
bool: item_exists = "item1" in test_list
out: item_exists

get: item <- test_list, 0
out: item

// 0-based index
index: index <- test_list, "item3"
out: index

set: <- test_list, 0, "item2"
out: test_list
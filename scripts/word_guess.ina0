out: "type a word: "
input: b
bool: c = b != "CHICKEN !"
nb: nombre = 1
bool: done = False

while: b != "CHICKEN !" and not done
    out: b
    out: "type a word: "
    input: b
    nb: nombre = nombre + 1
    bool: done = nombre == 10
    if: done
        out: "you already used up your ten tries"
    end_if
end_while

if: done
    out: "You didn't find the word, how bad"
end_if
if: not done
    out: "You found the word"
end_if
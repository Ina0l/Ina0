// There is no built-in dictionary like in python so that's how you code it yourself:

def: make_dict
    make_list: dict
    make_list: keys
    make_list: values
    append: <- dict, keys, values
    return: dict
end_def

def: set_value <- dict, key, value
    get: keys <- dict, 0
    get: values <- dict, 1
    if: not key in keys
        append: <- keys, key
        append: <- values, value
    end_if
    if: key in keys
        index: index <- keys, key
        set: <- values, index, value
    end_if
end_def

def: get_value <- dict, key
    get: keys <- dict, 0
    get: values <- dict, 1
    index: index <- keys, key
    get: value <- values, index
    return: value
end_def

make_dict: test_dict
set_value: <- test_dict, "a", 1
set_value: <- test_dict, "b", "aaa"
set_value: <- test_dict, "c", True

get_value: value <- test_dict, "a"
out: value

get_value: value <- test_dict, "b"
out: value

set_value: <- test_dict, "a", 2
get_value: value <- test_dict, "a"
out: value